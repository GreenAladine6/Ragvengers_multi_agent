# ========================================
# Gemini RAG Chatbot Configuration
# ========================================

# Google Gemini API Key
GEMINI_API_KEY="AIzaSyCwSeBGHHYzby6Jwzn9cuExfLORX1KA9ww"

# PostgreSQL Database with pgvector support
# Format: postgresql://username:password@host:port/database
# Note: Install pgvector extension: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/RAGvenger

# Optional: Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Chroma DB persistence directory (used for vector storage)
CHROMA_PERSIST_DIR=.chromadb
CHROMA_COLLECTION=report_chunks

# Use mock services (1) or real Gemini (0)
USE_MOCK=1

# Optional: Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Optional: RAG Pipeline Configuration
RAG_MAX_CHUNKS=10
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
CHROMA_PERSIST_DIR=./.chromadb
